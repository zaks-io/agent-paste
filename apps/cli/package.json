{
  "name": "@zaks-io/agent-paste",
  "license": "Apache-2.0",
  "version": "0.2.4",
  "type": "module",
  "description": "Command-line interface for publishing shareable Artifacts to Agent Paste.",
  "homepage": "https://agent-paste.sh",
  "bugs": {
    "url": "https://github.com/zaks-io/agent-paste/issues"
  },
  "author": "Zaks.io, LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaks-io/agent-paste.git",
    "directory": "apps/cli"
  },
  "bin": {
    "agent-paste": "dist/index.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/index.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "pnpm typecheck",
    "dev": "pnpm build && node dist/index.js",
    "lint": "biome lint .",
    "prepublishOnly": "node scripts/prepublish-guard.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --config ../../vitest.coverage.node.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@agent-paste/api-client": "workspace:*",
    "@agent-paste/contracts": "workspace:*",
    "@agent-paste/revise-core": "workspace:*",
    "@agent-paste/storage": "workspace:*",
    "@openclaw/fs-safe": "0.7.2",
    "esbuild": "^0.28.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@openclaw/fs-safe-darwin-arm64": "0.7.2",
    "@openclaw/fs-safe-darwin-x64": "0.7.2",
    "@openclaw/fs-safe-linux-arm64-gnu": "0.7.2",
    "@openclaw/fs-safe-linux-arm64-musl": "0.7.2",
    "@openclaw/fs-safe-linux-x64-gnu": "0.7.2",
    "@openclaw/fs-safe-linux-x64-musl": "0.7.2",
    "@openclaw/fs-safe-win32-x64-msvc": "0.7.2"
  }
}
