{
  "name": "@agent-paste/contracts",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./admin": {
      "source": "./src/admin.ts",
      "types": "./src/admin.ts",
      "import": "./dist/admin.js"
    },
    "./agent-view": {
      "source": "./src/agentView.ts",
      "types": "./src/agentView.ts",
      "import": "./dist/agentView.js"
    },
    "./api-keys": {
      "source": "./src/apiKeys.ts",
