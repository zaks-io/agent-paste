      "import": "./dist/mcp/tools-list.js"
    },
    "./primitives": {
      "source": "./src/primitives.ts",
      "types": "./src/primitives.ts",
      "import": "./dist/primitives.js"
    },
    "./render-mode": {
      "source": "./src/renderMode.ts",
      "types": "./src/renderMode.ts",
      "import": "./dist/renderMode.js"
    },
    "./revisions": {
      "source": "./src/revisions.ts",
