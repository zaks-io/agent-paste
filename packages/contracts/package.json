      "import": "./dist/apiKeys.js"
    },
    "./artifacts": {
      "source": "./src/artifacts.ts",
      "types": "./src/artifacts.ts",
      "import": "./dist/artifacts.js"
    },
    "./cli-version": {
      "source": "./src/cliVersion.ts",
      "types": "./src/cliVersion.ts",
      "import": "./dist/cliVersion.js"
    },
    "./common": {
      "source": "./src/common.ts",
      "types": "./src/common.ts",
      "import": "./dist/common.js"
    },
    "./ephemeral": {
      "source": "./src/ephemeral.ts",
      "types": "./src/ephemeral.ts",
      "import": "./dist/ephemeral.js"
    },
    "./mcp/edit": {
      "source": "./src/mcp/edit.ts",
      "types": "./src/mcp/edit.ts",
      "import": "./dist/mcp/edit.js"
    },
    "./mcp/scopes": {
      "source": "./src/mcp/scopes.ts",
      "types": "./src/mcp/scopes.ts",
      "import": "./dist/mcp/scopes.js"
    },
    "./mcp/tools-list": {
      "source": "./src/mcp/tools-list.ts",
