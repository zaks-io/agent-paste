    },
    "./workspace": {
      "source": "./src/workspace.ts",
      "types": "./src/workspace.ts",
      "import": "./dist/workspace.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "pnpm typecheck",
    "lint": "biome lint .",
    "openapi:check": "node ../../scripts/openapi-goldens.mjs",
    "openapi:write": "node ../../scripts/openapi-goldens.mjs --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --config ../../vitest.coverage.node.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-paste/auth-md": "workspace:*",
    "@agent-paste/config": "workspace:*",
    "@agent-paste/tokens": "workspace:*",
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
